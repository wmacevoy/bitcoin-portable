#!/bin/bash
#
# Build the bitcoin-portable Docker image and run bitcoind inside it.
# Block data is persisted in ./data on the host (mounted at /data).
#
# Usage:
#   ./run                 # run bitcoind (default CMD from the Dockerfile)
#   ./run bash            # open a shell in the container
#   ./run bitcoin-cli ... # run any command in the container

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

if ! cd "$SCRIPT_DIR"
then
    echo "Could not change directory to '$SCRIPT_DIR'" 1>&2
    exit 1
fi

if [ ! -f Dockerfile ]
then
    echo "'$SCRIPT_DIR' does not contain a Dockerfile." 1>&2
    exit 1
fi

if ! command -v docker > /dev/null 2>&1
then
    echo "docker is not installed or not on PATH." 1>&2
    exit 1
fi

DOCKER_TAG=$(basename "$SCRIPT_DIR")

echo "building image '$DOCKER_TAG'..."
if ! docker build -t "$DOCKER_TAG" .
then
    echo "docker build failed." 1>&2
    exit 1
fi

mkdir -p "$SCRIPT_DIR/data"

echo "running '$DOCKER_TAG' (mounting ./data at /data, p2p on 8333)..."
if [ $# -gt 0 ]
then
    exec docker run -it --rm \
        -v "$SCRIPT_DIR/data:/data" \
        -p 8333:8333 \
        "$DOCKER_TAG" \
        "$@"
else
    exec docker run -it --rm \
        -v "$SCRIPT_DIR/data:/data" \
        -p 8333:8333 \
        "$DOCKER_TAG"
fi
